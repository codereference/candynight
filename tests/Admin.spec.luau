local t = require("./lib/t")
local Admin = require("../src/shared/Rules/Admin")

t.test("only listed users are admins", function()
	t.expect(Admin.isAdmin({ 5224066822 }, 5224066822)).toBe(true)
	t.expect(Admin.isAdmin({ 5224066822 }, 1)).toBe(false)
end)

t.test("good commands come back with clean arguments", function()
	t.expect(Admin.validate("giveCash", { "Sep_1264", 1000 })).toEqual({ "Sep_1264", 1000 })
	t.expect(Admin.validate("giveCash", { nil, 50 })).toEqual({ "me", 50 })
	t.expect(Admin.validate("skipPhase", nil)).toEqual({})
	t.expect(Admin.validate("spawnCreatures", { 5 })).toEqual({ 5 })
end)

t.test("unknown commands and bad arguments are refused", function()
	t.expect(select(2, Admin.validate("deleteGame", {}))).toBe("unknown")
	t.expect(select(2, Admin.validate(42, {}))).toBe("unknown")
	t.expect(select(2, Admin.validate("giveCash", { "me", -5 }))).toBe("args")
	t.expect(select(2, Admin.validate("giveCash", { "me", 1.5 }))).toBe("args")
	t.expect(select(2, Admin.validate("giveCash", { "me", 0 / 0 }))).toBe("args")
	t.expect(select(2, Admin.validate("spawnCreatures", { 1000 }))).toBe("args")
	t.expect(select(2, Admin.validate("setStreak", { string.rep("x", 50), 3 }))).toBe("args")
end)
