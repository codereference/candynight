local t = require("./lib/t")
local Plots = require("../src/shared/Rules/Plots")

t.test("players get the lowest free plot", function()
	local plots = Plots.new(6)
	t.expect(plots:claim(101)).toBe(1)
	t.expect(plots:claim(102)).toBe(2)
	t.expect(plots:ownerOf(2)).toBe(102)
end)

t.test("claiming twice returns the same plot", function()
	local plots = Plots.new(6)
	plots:claim(101)
	t.expect(plots:claim(101)).toBe(1)
end)

t.test("a full server has no plot to give", function()
	local plots = Plots.new(2)
	plots:claim(1)
	plots:claim(2)
	t.expect(plots:claim(3)).toBe(nil)
end)

t.test("leaving frees the plot for the next player", function()
	local plots = Plots.new(2)
	plots:claim(1)
	plots:claim(2)
	t.expect(plots:release(1)).toBe(1)
	t.expect(plots:ownerOf(1)).toBe(nil)
	t.expect(plots:claim(3)).toBe(1)
end)

t.test("releasing someone without a plot does nothing", function()
	local plots = Plots.new(2)
	t.expect(plots:release(99)).toBe(nil)
end)
